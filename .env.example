# ==============================================================================
# AI RAMU ENVIRONMENT CONFIGURATION
# Bolo Ramu, Kaam Shuru.
# ==============================================================================

# Server Gateway Settings
RAMU_HOST=127.0.0.1
RAMU_PORT=8080
RAMU_LANGUAGE=en # en (English), hi (Hindi), bn (Bengali)
RAMU_WORKSPACE=./workspace

# AI Provider Configuration (Configure one or more)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama (No API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Default Active Provider (openai | gemini | anthropic | groq | ollama)
ACTIVE_PROVIDER=gemini

# Integrations (Optional)
# Telegram Bot Token
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=

# WhatsApp Gateway (Local QR Pair Mode)
WHATSAPP_ENABLED=false

# Google Workspace OAuth (Gmail & Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/oauth/google/callback

# Security & Autonomy Guard
REQUIRE_HUMAN_APPROVAL_FOR_DESTRUCTIVE=true
ALLOWED_DIRECTORY_ROOT=./workspace
ENABLE_AUDIT_LOG=true
