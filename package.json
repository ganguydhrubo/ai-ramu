{
  "name": "ai-ramu",
  "version": "2026.10.6-ramu.1",
  "private": true,
  "description": "AI RAMU — Bolo Ramu, Kaam Shuru. Free, open-source AI worker that runs on your own computer.",
  "license": "MIT",
  "homepage": "https://airamu.site/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ganguydhrubo/ai-ramu.git"
  },
  "type": "module",
  "bin": {
    "ramu": "bin/ramu.mjs",
    "ai-ramu": "bin/ramu.mjs"
  },
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "start": "node bin/ramu.mjs start",
    "onboard": "node bin/ramu.mjs onboard",
    "whatsapp": "node bin/ramu.mjs whatsapp",
    "doctor": "node bin/ramu.mjs doctor",
    "ramu": "node bin/ramu.mjs",
    "postinstall": "node scripts/rebrand-engine.mjs apply --if-needed",
    "rebrand": "node scripts/rebrand-engine.mjs apply",
    "rebrand:check": "node scripts/rebrand-engine.mjs check",
    "rebrand:report": "node scripts/rebrand-engine.mjs report",
    "test": "node --test \"test/*.test.mjs\"",
    "verify:branding": "node scripts/verify-branding.mjs",
    "smoke": "node scripts/smoke.mjs",
    "sync": "node scripts/upstream.mjs update",
    "sync:check": "node scripts/upstream.mjs check",
    "rollback": "node scripts/upstream.mjs rollback",
    "brand:render": "node scripts/render-brand-assets.mjs"
  },
  "dependencies": {
    "openclaw": "2026.10.6"
  },
  "allowScripts": {
    "openclaw": true,
    "koffi": true,
    "protobufjs": true,
    "esbuild": true,
    "@google/genai": false
  }
}
